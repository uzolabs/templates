# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git-ignored. Never commit it, and never paste a key that holds real funds.

# Private key of a TEST wallet (0x prefix optional). Fund it with tBOT at
# https://faucet.botchain.ai/basic
PRIVATE_KEY=

# Optional. Leave blank to use the public RPCs from @uzolabs/sdk.
BOT_TESTNET_RPC_URL=
BOT_MAINNET_RPC_URL=

# Set to true (or pass --mainnet) to target BOT Chain mainnet. You will still be
# asked to type MAINNET before anything is sent.
MAINNET=false

# --- gasless-app template ---
# The relayer (`npm run relayer`) sends the guest book transactions and pays their gas.
# Use a SEPARATE test wallet for it, not your deployer, and fund it with tBOT from the faucet.
# It only ever calls the forwarder, and only for GuestBook.sign.
RELAYER_PRIVATE_KEY=
# Port the relayer listens on. The web app reads VITE_RELAYER_URL from frontend/.env.
RELAYER_PORT=8787
# Requests allowed per signer and per IP address in each window (default 10 per hour).
RELAYER_RATE_LIMIT=10
RELAYER_RATE_WINDOW_SECONDS=3600
# Comma separated origins the browser may call the relayer from. Blank allows any origin.
RELAYER_ALLOWED_ORIGINS=http://localhost:5173
# The most gas one request may ask the forwarder to pass on to GuestBook.sign.
RELAYER_MAX_GAS=300000
# Set to true only behind your own reverse proxy, so the per IP limit reads X-Forwarded-For.
RELAYER_TRUST_PROXY=false
# Warn in the relayer log when its balance drops below this many BOT.
RELAYER_LOW_BALANCE=1

# Optional, off by default. A BOT Chain paymaster endpoint (pm_isSponsorable, then a gas price 0
# transaction). No public paymaster for chain 677 is confirmed, so leave this blank unless you have one.
PAYMASTER_URL=

{
  "name": "uzo-template-gasless-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BOT Chain starter: a guest book that wallets with zero tBOT can sign, through an ERC-2771 forwarder and a relayer.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "build:hardhat": "hardhat build",
    "test:hardhat": "hardhat test solidity",
    "test:relayer": "tsx --test relayer/test/*.test.ts",
    "deploy": "tsx scripts/deploy.ts --tool foundry",
    "deploy:hardhat": "tsx scripts/deploy.ts --tool hardhat",
    "verify": "tsx scripts/verify.ts --tool foundry",
    "verify:hardhat": "tsx scripts/verify.ts --tool hardhat",
    "relayer": "tsx relayer/src/server.ts",
    "sign": "tsx scripts/sign.ts",
    "abi": "forge build && tsx scripts/export-abi.ts",
    "frontend": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix frontend install --no-audit --no-fund",
    "typecheck": "tsc --noEmit && tsc --noEmit -p relayer"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@uzolabs/sdk": "^0.2.0",
    "hono": "^4.13.12",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.10.0",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^3.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

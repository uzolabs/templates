# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git-ignored. Never commit it, and never paste a key that holds real funds.

# Private key of a TEST wallet (0x prefix optional). Fund it with tBOT at
# https://faucet.botchain.ai/basic
PRIVATE_KEY=

# Optional. Leave blank to use the public RPCs from @uzolabs/sdk.
BOT_TESTNET_RPC_URL=
BOT_MAINNET_RPC_URL=

# Set to true (or pass --mainnet) to target BOT Chain mainnet. You will still be
# asked to type MAINNET before anything is sent.
MAINNET=false

# --- nft template ---
# Collection settings used by both `npm run deploy` and `npm run deploy:hardhat`.
NFT_NAME="Uzo NFT"
NFT_SYMBOL=UZONFT
# Price of one mint in BOT (tBOT on testnet). Decimals are fine, for example 0.01
NFT_MINT_PRICE=0.01
# The most tokens that can ever be minted.
NFT_MAX_SUPPLY=1000

# Optional, off by default. Only needed for `npm run upload-metadata`, which pins a
# metadata file to IPFS through Pinata. The contract does not need it: its artwork is on chain.
PINATA_JWT=
